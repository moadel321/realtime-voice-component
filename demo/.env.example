OPENAI_API_KEY=your_openai_api_key

# Required only when running the demo against Ultravox v0.7.
# Get a key at https://app.ultravox.ai/.
ULTRAVOX_API_KEY=your_ultravox_api_key

# Selects which model the demo session provider uses.
# "openai" (default) uses the GPT-Realtime path; "ultravox" uses ultravox-v0.7.
# VITE_VOICE_PROVIDER=openai

# Optional. Only set this if you have your own Picovoice access key and local
# Porcupine assets in demo/public/porcupine/.
# VITE_PICOVOICE_ACCESS_KEY=your_picovoice_access_key
